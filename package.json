{
  "name": "no-thanks",
  "version": "1.0.0",
  "description": "An autonomous cookie-consent agent built with the Strands Agents SDK and Playwright.",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude tests/e2e/**",
    "test:e2e": "vitest run tests/e2e",
    "fixtures": "npm run build --silent && node dist/src/fixtures/server.js",
    "guardian": "npm run build --silent && node dist/src/cli.js",
    "no-thanks": "npm run build --silent && node dist/src/cli.js",
    "browser": "npm run build --silent && node dist/src/browser-cli.js",
    "browser:smoke": "npm run build --silent && node dist/scripts/browser-smoke.js",
    "dev": "npm run fixtures",
    "start": "node dist/src/cli.js",
    "bedrock:smoke": "npm run build --silent && node dist/scripts/bedrock-smoke.js"
  },
  "dependencies": {
    "@strands-agents/sdk": "1.16.0",
    "dotenv": "16.6.1",
    "openai": "^6.49.0",
    "playwright": "1.63.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "22.18.1",
    "eslint": "9.35.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "4.1.11"
  }
}
