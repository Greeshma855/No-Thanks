# Select exactly one provider.
MODEL_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=YOUR-OPENAI-API-KEY-HERE
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=800

# Bedrock — retained for switching later.
# Do not store AWS access keys here.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Only these websites may be sent to the remote model.
# Add additional exact hosts when necessary.
REMOTE_ANALYSIS_ALLOWED_HOSTS=

MAX_MODEL_CALLS_PER_AUDIT=3
MAX_CONCURRENT_AUDITS=1
SCREENSHOT_MAX_WIDTH=1280
SCREENSHOT_JPEG_QUALITY=75

# Persistent headed browser mode — fitted to your screen.
BROWSER_VIEWPORT_WIDTH=1260
BROWSER_VIEWPORT_HEIGHT=540
BROWSER_SLOW_MO_MS=400

# Deterministic single-URL mode.
GUARDIAN_MODE=inspector
GUARDIAN_MAX_STEPS=8
GUARDIAN_MIN_CONFIDENCE=0.75
GUARDIAN_ARTIFACT_DIR=artifacts

GUARDIAN_DISPLAY_PROFILE=custom
GUARDIAN_VIEWPORT_WIDTH=1260
GUARDIAN_VIEWPORT_HEIGHT=540

# Slower presentation pacing.
GUARDIAN_DEMO_PACING=true
GUARDIAN_SLOW_MO_MS=400
GUARDIAN_STEP_DELAY_MS=700
GUARDIAN_HIGHLIGHT_DELAY_MS=800
GUARDIAN_FINAL_HOLD_MS=1500

GUARDIAN_RECORD_VIDEO=true
GUARDIAN_RECORD_TRACE=false
GUARDIAN_REPORT_EMBED_SCREENSHOTS=true
GUARDIAN_ALLOW_MOCK_FALLBACK=false
